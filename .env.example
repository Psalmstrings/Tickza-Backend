# ─────────────────────────────────────────────────────────────────
# TICKZA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in server/ directory or root for development & production.
# NEVER COMMIT ACTUAL SECRETS TO SOURCE CONTROL.
# ─────────────────────────────────────────────────────────────────

# Server & Runtime Configuration
PORT=5090
NODE_ENV=development
CLIENT_URL=http://localhost:5173
BASE_URL=http://localhost:5090

# Database Connection (MongoDB Atlas or Local replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/tickza?retryWrites=true&w=majority

# Authentication Secrets (Generate strong random 64-char strings)
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_super_secret_key_change_in_production

# Email Service Configuration (Gmail SMTP)
# Generate a Google App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_character_app_password
EMAIL_FROM="Tickza <your_email@gmail.com>"

# Optional Initial Super Admin Setup (Seeded safely only if provided)
ADMIN_EMAIL=admin@tickza.com
ADMIN_PASSWORD=SecureAdminPassword123!
ADMIN_FIRST=Super
ADMIN_LAST=Admin
ADMIN_PHONE=+2348000000000

# Cloudinary Storage (Optional - falls back to local /uploads storage if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack Payment Gateway Configuration (Nigerian Naira - NGN only)
# Test keys begin with sk_test_ / pk_test_ ; Production keys begin with sk_live_ / pk_live_
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_CALLBACK_URL=http://localhost:5173/tickets/verify-payment
# Optional: Dedicated webhook secret (defaults to PAYSTACK_SECRET_KEY if omitted)
PAYSTACK_WEBHOOK_SECRET=
